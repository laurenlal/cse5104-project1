      "MSE: 141.08573604288478, R2: 0.3695023883348443\n"
     ]
    }
   ],
   "source": [
    "weights_scaled, bias_scaled, loss_scaled = gradient_descent(\n",
    "    X_train_std,\n",
    "    y_train,\n",
    "    learning_rate=0.0001,\n",
    "    tolerance=1e-6\n",
    ")\n",
    "\n",
    "mse_scaled, r2_scaled = evaluate(\n",
    "    X_test_std,\n",
    "    y_test,\n",
    "    weights_scaled,\n",
    "    bias_scaled\n",
    ")\n",
    "\n",
    "print(f\"MSE: {mse_scaled}, R2: {r2_scaled}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "96028cfb",
   "metadata": {},
   "source": [
    "## Provide a figure showing loss over iterations for both"
   ]
  },
  {
