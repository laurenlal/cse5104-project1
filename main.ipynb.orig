  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d1ed6b39",
   "metadata": {},
   "outputs": [],
   "source": [
    "y_train_log = log_model.predict(X_train_log)\n",
    "y_test_log = log_model.predict(X_test_log)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0218d65a",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_log_mse = np.mean((y_train - y_train_log) ** 2)\n",
    "train_log_r2 = 1 - train_log_mse / np.var(y_train)\n",
    "\n",
    "test_log_mse = np.mean((y_test - y_test_log) ** 2)\n",
    "test_log_r2 = 1 - test_log_mse / np.var(y_test)\n",
    "\n",
    "print(f\"Train Log MSE: {train_log_mse}, Train Log R2: {train_log_r2}\")\n",
    "print(f\"Test Log MSE: {test_log_mse}, Test Log R2: {test_log_r2}\")"
   ]
  },
