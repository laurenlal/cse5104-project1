  },
  {
   "cell_type": "markdown",
   "id": "8ca9e9be",
   "metadata": {},
   "source": [
    "**Standarized/Normalized Features**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "c7f6635d",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Standardize the features\n",
    "training_mean = X_train.mean(axis=0)\n",
    "training_std = X_train.std(axis=0)\n",
    "\n",
    "X_train_std = (X_train - training_mean) / training_std\n",
    "X_test_std = (X_test - training_mean) / training_std"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "20427491",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Learning Rate: 1e-08\n",
      "MSE: 1015.2115777870446, R2: -3.536875896050775\n",
      "Learning Rate: 1e-07\n",
      "MSE: 1011.3935862715739, R2: -3.5198136855156834\n",
      "Learning Rate: 1e-06\n",
      "MSE: 974.0367607471388, R2: -3.3528698828807455\n",
      "Learning Rate: 1e-05\n",
      "MSE: 672.0720785687311, R2: -2.0034208438734074\n",
      "Learning Rate: 0.0001\n",
      "MSE: 104.16247912669178, R2: 0.5345086175505488\n",
      "Learning Rate: 0.001\n",
      "MSE: 133.3949577842348, R2: 0.40387168362952386\n",
